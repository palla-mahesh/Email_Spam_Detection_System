# ==========================================
# Zero-API-Key Unified Vercel Deployment
# No external API keys are required to run or deploy MailGuard AI on Vercel.
# All variables below are OPTIONAL overrides only.
# ==========================================

# Server Settings (Optional)
PORT=3000
JWT_SECRET="optional-custom-jwt-signing-secret"
ALLOWED_ORIGINS=""

# Frontend Same-Origin Default (Optional - leave empty for unified Vercel deployment)
VITE_API_URL=""

# Optional: External Supabase PostgreSQL (only if using separate Python FastAPI backend)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Optional: External SMTP Relay & Inbound Mail Webhook Secret
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
INBOUND_MAIL_WEBHOOK_SECRET=""
